# ─────────────────────────────────────────────────────────────
# LMS Grupo TMC · Variables de entorno
# Copia este archivo como .env.local (desarrollo) o cárgalas en Vercel (producción).
# NUNCA subas valores reales al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Llave pública ("publishable", sb_publishable_…). También se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta ("secret", sb_secret_…). SOLO servidor. También se acepta SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# URL pública de la app (se usa en los enlaces de los correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# development | production
APP_ENV=development

# Dominio técnico para quienes no tienen correo (D1). Nunca recibe correos.
INTERNAL_EMAIL_DOMAIN=users.lms.internal

# Solo para el script de datos demo (desarrollo)
SEED_PASSWORD=

# Conversión automática de PowerPoint/Word a PDF (opcional; sin ella se adjunta el PDF a mano)
# CloudConvert → Dashboard → API Keys (permisos: task.read, task.write)
CLOUDCONVERT_API_KEY=

# ── Fases siguientes ─────────────────────────────────────────
# Correo (Fase 8): Resend → API Keys
RESEND_API_KEY=
EMAIL_FROM="Capacitación Grupo TMC <no-responder@grupotmc.com.mx>"
# Secreto que usa pg_cron para llamar /api/jobs/* (Fase 8)
JOBS_SECRET=
# Errores en producción (Fase 10)
SENTRY_DSN=

# Para aplicar migraciones con npm run db:migrate (solo en la computadora de quien administra)
SUPABASE_DB_PASSWORD=

# Respaldos (npm run db:backup): frase de cifrado, mínimo 16 caracteres
BACKUP_PASSPHRASE=
